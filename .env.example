# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Branding used on receipts and headers
NEXT_PUBLIC_SCHOOL_NAME="Bright Future International School"
NEXT_PUBLIC_SCHOOL_ADDRESS="12 Ahmadu Bello Way, Kaduna, Nigeria"
NEXT_PUBLIC_SCHOOL_PHONE="+234 800 000 0000"
